      "summary": "Add the overtime helper module.",
      "files": [
        {
          "path": "pkg/overtime.py",
          "operation": "create",
          "content": "def overtime_pay(hours: float, rate: float) -> float:\n    \"\"\"Pay 1.5x for every hour above the weekly threshold.\"\"\"\n    regular = min(hours, 40.0)\n    extra = max(hours - 40.0, 0.0)\n    return regular * rate + extra * rate * 1.5\n",
          "sha256": null
        }
      ]
    },
