# Copy to .env and fill in real values. Never commit .env.
# Keys are read only by the host orchestrator / LLM router. They are never
# passed into the sandbox container, Redis or Qdrant.
NVIDIA_NIM_API_KEY=''
GROQ_API_KEY=''
OPENAI_API_KEY=''
GEMINI_API_KEY=''
JWT_SECRET=''

# The HTTP gateway. The gateway binds to 127.0.0.1 by default; set the host
# to 0.0.0.0 only on a network that is trusted, and mark the cookie as
# secure when the gateway sits behind TLS.
ORACLE_HCM_JWT_TTL_SECONDS='3600'
ORACLE_HCM_CORS_ORIGINS=''
ORACLE_HCM_MAX_REQUEST_BYTES='65536'
ORACLE_HCM_API_HOST='127.0.0.1'
ORACLE_HCM_API_PORT='8000'
ORACLE_HCM_COOKIE_SECURE='0'
ORACLE_HCM_LOGIN_MAX_ATTEMPTS='5'
ORACLE_HCM_LOGIN_WINDOW_SECONDS='900'
ORACLE_HCM_LOGIN_LOCKOUT_SECONDS='900'
ORACLE_HCM_LOGIN_MAX_ATTEMPTS_PER_IP='30'
ORACLE_HCM_KEEP_ALIVE_SECONDS='15'

# Local infrastructure. REDIS_URL wins over REDIS_PASSWORD when both are set.
REDIS_URL=''
REDIS_PASSWORD=''
